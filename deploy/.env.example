# Salin menjadi .env lalu isi. Jangan commit file .env.
# Buat nilai acak:
#   DB_PASSWORD:       openssl rand -hex 24
#   ANTAREJA_APP_KEY:  echo "base64:$(openssl rand -base64 32)"
# ANTAREJA_APP_KEY mengenkripsi kredensial SNMP. SIMPAN CADANGANNYA: bila hilang, semua kredensial harus diisi ulang.
DB_PASSWORD=
ANTAREJA_APP_KEY=
ANTAREJA_TAG=0.4.0
# Alamat web (dipakai untuk tautan di notifikasi/laporan). Tulis port di APP_URL hanya bila HTTPS_PORT bukan 443.
APP_URL=https://IP-VM-ANDA
# Port web. Bawaan 80 (http://IP-VM, dialihkan otomatis ke HTTPS) dan 443.
# Ganti bila bentrok dengan aplikasi lain di VM yang sama, mis. HTTP_PORT=8080 & HTTPS_PORT=8443 (APP_URL ikut :8443).
HTTP_PORT=80
HTTPS_PORT=443
# Port syslog di VM (UDP+TCP). Arahkan log perangkat ke IP-VM:514.
SYSLOG_PORT=514
# Port SNMP trap di VM (UDP). Arahkan trap perangkat ke IP-VM:162.
TRAP_PORT=162
PING_INTERVAL=60s
SNMP_INTERVAL=5m
LATENCY_HIGH_MS=150
METRICS_RETENTION=400d
TZ=Asia/Jakarta
# Folder backup database (di VM). Disarankan folder NAS yang di-mount (mis. /mnt/nas/antareja) agar aman bila VM rusak.
BACKUP_DIR=./backups
