# Alamat web pusat ANTAREJA (https). Harus bisa dijangkau dari site.
ANTAREJA_CENTRAL_URL=https://nms.kantor.local
# Token dari halaman Collector site di web pusat. Rahasia: jangan dibagikan atau di-commit.
ANTAREJA_SITE_TOKEN=
# Opsional: path berkas CA (PEM) di mesin ini bila sertifikat pusat dari CA internal kantor
# CENTRAL_CA_FILE=/etc/antareja/ca.pem
# Batas antrean di disk saat jalur ke pusat putus (MB). 512 MB cukup untuk beberapa hari pada ratusan perangkat.
SPOOL_MAX_MB=512
TZ=Asia/Jakarta
